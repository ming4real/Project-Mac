SUMMARY = "Linux image for the MacBook Pro 14,3 internal SSD"
DESCRIPTION = "A Yocto Project Linux distribution for repurposed Intel Macs"
LICENSE = "MIT"

require mac-image-common.inc

IMAGE_FEATURES += "package-management"
PACKAGE_FEED_URIS = "${OPKG_SERVER_URL}"
PACKAGE_FEED_ARCHS = "all ${TUNE_PKGARCH} ${MACHINE_ARCH}"

# Keep Weston available without its boot-time service and login profile.
BAD_RECOMMENDATIONS:append = " weston-init"

IMAGE_INSTALL:append = " packagegroup-mac-development"
IMAGE_INSTALL:append = " weston"
IMAGE_INSTALL:append = " weston-xwayland"
IMAGE_INSTALL:append = " flatpak"
IMAGE_INSTALL:append = " pavucontrol"
IMAGE_INSTALL:append = " bluez5"
IMAGE_INSTALL:append = " v4l-utils"
IMAGE_INSTALL:append = " cheese"
IMAGE_INSTALL:append = " ristretto"
IMAGE_INSTALL:append = " gstreamer1.0"
IMAGE_INSTALL:append = " gstreamer1.0-plugins-base"
IMAGE_INSTALL:append = " gstreamer1.0-plugins-good"
IMAGE_INSTALL:append = " gstreamer1.0-plugins-bad"
IMAGE_INSTALL:append = " gstreamer1.0-meta-audio"
IMAGE_INSTALL:append = " gstreamer1.0-meta-video"
IMAGE_INSTALL:append = " gstreamer1.0-meta-x11-base"

# Xorg uses the existing DRM stack through logind and the modesetting driver.
IMAGE_INSTALL:append = " xserver-xorg"
IMAGE_INSTALL:append = " xserver-xorg-extension-glx"
IMAGE_INSTALL:append = " xf86-video-modesetting"
IMAGE_INSTALL:append = " xrandr"
IMAGE_INSTALL:append = " liberation-fonts"

IMAGE_INSTALL:append = " xfce-autostart"
IMAGE_INSTALL:append = " xfce4-session"
IMAGE_INSTALL:append = " xfwm4"
IMAGE_INSTALL:append = " xfdesktop"
IMAGE_INSTALL:append = " xfconf"
IMAGE_INSTALL:append = " xfce4-settings"
IMAGE_INSTALL:append = " xfce4-appfinder"
IMAGE_INSTALL:append = " xfce4-panel"
# The default Xfce panel uses plugins packaged separately by meta-xfce.
IMAGE_INSTALL:append = " xfce4-panel-plugin-actions"
IMAGE_INSTALL:append = " xfce4-panel-plugin-applicationsmenu"
IMAGE_INSTALL:append = " xfce4-panel-plugin-clock"
IMAGE_INSTALL:append = " xfce4-panel-plugin-directorymenu"
IMAGE_INSTALL:append = " xfce4-panel-plugin-launcher"
IMAGE_INSTALL:append = " xfce4-panel-plugin-pager"
IMAGE_INSTALL:append = " xfce4-panel-plugin-separator"
IMAGE_INSTALL:append = " xfce4-panel-plugin-showdesktop"
IMAGE_INSTALL:append = " xfce4-panel-plugin-systray"
IMAGE_INSTALL:append = " xfce4-panel-plugin-tasklist"
IMAGE_INSTALL:append = " xfce4-panel-plugin-windowmenu"

IMAGE_INSTALL:append = " thunar"
IMAGE_INSTALL:append = " thunar-volman"
IMAGE_INSTALL:append = " xfce4-terminal"
IMAGE_INSTALL:append = " xfce4-notifyd"
IMAGE_INSTALL:append = " xfce4-screensaver"
IMAGE_INSTALL:append = " xfce-polkit"
IMAGE_INSTALL:append = " xfce4-battery-plugin"
IMAGE_INSTALL:append = " librsvg-gtk"
IMAGE_INSTALL:append = " xdg-desktop-portal"
IMAGE_INSTALL:append = " xdg-desktop-portal-gtk"
